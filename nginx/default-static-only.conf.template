server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        # Revalidar siempre (ETag): evita que el navegador use app.js/styles.css
        # viejos después de un deploy.
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
